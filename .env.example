# ---- 基础 ----
# 数据库：默认 compose 使用 Postgres；单机试用可用 sqlite:///./llmtrace.db
DATABASE_URL=postgresql+psycopg://llmtrace:llmtrace@db:5432/llmtrace
# 生产必改：长随机字符串
JWT_SECRET=change-me-in-production-with-a-long-random-string
# 前端地址（SSO 回跳用，默认同源部署可不填）
FRONTEND_URL=

# ---- 首次启动 ----
# true 时注入演示项目与示例 trace（幂等，demo 项目存在即跳过）
SEED_DEMO=true

# ---- 飞书 SSO（可选，不配则登录页隐藏飞书按钮）----
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=
FEISHU_DEFAULT_ROLE=member
